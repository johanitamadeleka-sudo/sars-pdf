<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ doc.document.report_title }}</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
{#
  Primary region top-10 schools per SUBJECT (SHULE 10 BORA ... SOMO LA <subject>).
  Section-centric: 6 subject blocks (one per subject), TWO to a page over 3 pages.
  Pagination is DATA-DRIVEN via s.page_top (True only for the first block on each page).
  Two source variants (data tags) share this ONE template: JUMLA has an UMILIKI column,
  SERIKALI does not (s.has_own). Fully self-contained (own template + own style.css, inline
  @font-face, single family name, no fallback, no @import). No data-driven colour here (this
  report's original does not tint the grade/competency cells).

  Columns: S/N | HALMASHAURI | JINA LA SHULE | [UMILIKI]
    IDADI YA WATAHINIWA (WALIOSAJILIWA, WALIOFANYA) + UFAULU WA MADARAJA (A B C D E(+%) A-D(+%))
    each WAV/WAS/JML | WASTANI WA SOMO (ALAMA + DRJ) | NAFASI
#}
<div class="titles">
  {% for line in doc.document.ministry %}
  <div class="hl ministry">{{ line }}</div>
  {% endfor %}
  <div class="hl exam-name">{{ doc.document.exam_name }}</div>
</div>

{% macro nums(r) %}
  <td>{{ r.reg_f }}</td><td>{{ r.reg_m }}</td><td class="b">{{ r.reg_t }}</td>
  <td>{{ r.fanya_f }}</td><td>{{ r.fanya_m }}</td><td class="b">{{ r.fanya_t }}</td>
  <td>{{ r.a_f }}</td><td>{{ r.a_m }}</td><td class="b">{{ r.a_t }}</td>
  <td>{{ r.b_f }}</td><td>{{ r.b_m }}</td><td class="b">{{ r.b_t }}</td>
  <td>{{ r.c_f }}</td><td>{{ r.c_m }}</td><td class="b">{{ r.c_t }}</td>
  <td>{{ r.d_f }}</td><td>{{ r.d_m }}</td><td class="b">{{ r.d_t }}</td>
  <td>{{ r.e_f }}</td><td>{{ r.e_m }}</td><td class="b">{{ r.e_t }}</td><td class="b">{{ r.e_pct }}</td>
  <td>{{ r.ad_f }}</td><td>{{ r.ad_m }}</td><td class="b">{{ r.ad_t }}</td><td class="b">{{ r.ad_pct }}</td>
  <td class="b">{{ r.alama }}</td><td>{{ r.drj }}</td>
{% endmacro %}

{% macro fmt_heads() %}
<tr class="hf">
  <th>WAV</th><th>WAS</th><th>JML</th>
  <th>WAV</th><th>WAS</th><th>JML</th>
  <th>WAV</th><th>WAS</th><th>JML</th>
  <th>WAV</th><th>WAS</th><th>JML</th>
  <th>WAV</th><th>WAS</th><th>JML</th>
  <th>WAV</th><th>WAS</th><th>JML</th>
  <th>WAV</th><th>WAS</th><th>JML</th><th>%</th>
  <th>WAV</th><th>WAS</th><th>JML</th><th>%</th>
</tr>
{% endmacro %}

{% for s in doc.sections %}
<div class="section{% if not loop.first and s.page_top %} page-top{% endif %}">
  <div class="sec-title">{{ s.title }}</div>
  <table class="grid{% if not s.has_own %} noown{% endif %}">
    <colgroup>
      <col><col><col>{% if s.has_own %}<col>{% endif %}
      <col><col><col>  <col><col><col>
      <col><col><col>  <col><col><col>  <col><col><col>  <col><col><col>
      <col><col><col>  <col><col><col><col>  <col><col><col><col>
      <col><col>
      <col>
    </colgroup>
    <thead>
      <tr class="hg">
        <th rowspan="3" class="v-mid">S/N</th>
        <th rowspan="3" class="v-mid">HALMASHAURI</th>
        <th rowspan="3" class="v-mid">JINA LA SHULE</th>
        {% if s.has_own %}<th rowspan="3" class="v-mid">UMILIKI</th>{% endif %}
        <th colspan="6" class="grp">IDADI YA WATAHINIWA</th>
        <th colspan="20" class="grp">UFAULU WA MADARAJA</th>
        <th colspan="2" class="grp v-mid">WASTANI WA SOMO</th>
        <th rowspan="3" class="v-mid">NAFASI</th>
      </tr>
      <tr class="hs">
        <th colspan="3">WALIOSAJILIWA</th>
        <th colspan="3">WALIOFANYA</th>
        <th colspan="3">A</th>
        <th colspan="3">B</th>
        <th colspan="3">C</th>
        <th colspan="3">D</th>
        <th colspan="4">E</th>
        <th colspan="4">A-D</th>
        <th rowspan="2" class="v-mid">ALAMA</th>
        <th rowspan="2" class="v-mid">DRJ</th>
      </tr>
      {{ fmt_heads() }}
    </thead>
    <tbody>
      {% for r in s.rows %}
      <tr class="row">
        <td>{{ r.sn }}</td>
        <td class="txt">{{ r.council }}</td>
        <td class="txt">{{ r.school }}</td>
        {% if s.has_own %}<td class="txt">{{ r.ownership }}</td>{% endif %}
        {{ nums(r) }}
        <td class="b">{{ r.nm }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}
</body>
</html>
