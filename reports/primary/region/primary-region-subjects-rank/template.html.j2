<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ doc.document.report_title }}</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
{#
  Primary region subjects rank (LEVEL + FUNCTION name). One logical row per SUBJECT, plus a
  JUMLA total row. Region WAV/WAS/JML division grid over 7 grade groups. Fully self-contained
  (own template + own style.css, inline @font-face, single family name, no fallback, no
  @import). KUNDI LA UMAHIRI (competency-level) background is the ONLY data-driven colour.

  Columns: S/N | SOMO | A | B | C | D | A-D(+%) | WASIOFAULU E(+%) | JUMLA YA WATAHINIWA
    (each WAV/WAS/JML) | WASTANI WA SOMO | NAFASI YA SOMO | KUNDI LA UMAHIRI
#}
<div class="titles">
  {% for line in doc.document.ministry %}
  <div class="hl ministry">{{ line }}</div>
  {% endfor %}
  <div class="hl exam-name">{{ doc.document.exam_name }}</div>
</div>

{% macro numrow(r, total=False) %}
  <td>{{ r.a_f }}</td><td>{{ r.a_m }}</td><td class="b">{{ r.a_t }}</td>
  <td>{{ r.b_f }}</td><td>{{ r.b_m }}</td><td class="b">{{ r.b_t }}</td>
  <td>{{ r.c_f }}</td><td>{{ r.c_m }}</td><td class="b">{{ r.c_t }}</td>
  <td>{{ r.d_f }}</td><td>{{ r.d_m }}</td><td class="b">{{ r.d_t }}</td>
  <td>{{ r.ad_f }}</td><td>{{ r.ad_m }}</td><td class="b">{{ r.ad_t }}</td><td class="b">{{ r.ad_pct }}</td>
  <td>{{ r.e_f }}</td><td>{{ r.e_m }}</td><td class="b">{{ r.e_t }}</td><td class="b">{{ r.e_pct }}</td>
  <td>{{ r.jml_f }}</td><td>{{ r.jml_m }}</td><td class="b">{{ r.jml_t }}</td>
  <td class="b">{{ r.wastani }}</td>
  {% if not total %}<td class="b">{{ r.nafasi }}</td>{% endif %}
{% endmacro %}

{% set s = doc.sections[0] %}
<div class="sec-title">{{ s.title }}</div>
<table class="grid">
  <colgroup>
    <col><col>
    <col><col><col>  <col><col><col>  <col><col><col>  <col><col><col>
    <col><col><col><col>  <col><col><col><col>  <col><col><col>
    <col><col><col>
  </colgroup>
  <thead>
    <tr class="hg">
      <th rowspan="3" class="v-mid">S/N SOMO</th>
      <th rowspan="3" class="v-mid">SOMO</th>
      <th colspan="20" class="grp">TATHIMINI YA UFAULU KIMADARAJA</th>
      <th colspan="3" class="grp">JUMLA YA WATAHINIWA</th>
      <th rowspan="3" class="v-mid">WASTANI WA SOMO</th>
      <th rowspan="3" class="v-mid">NAFASI YA SOMO</th>
      <th rowspan="3" class="v-mid">KUNDI LA UMAHIRI</th>
    </tr>
    <tr class="hs">
      <th colspan="3">A</th><th colspan="3">B</th><th colspan="3">C</th><th colspan="3">D</th>
      <th colspan="4">A-D</th><th colspan="4">WASIOFAULU ( E)</th>
    </tr>
    <tr class="hf">
      <th>WAV</th><th>WAS</th><th>JML</th>
      <th>WAV</th><th>WAS</th><th>JML</th>
      <th>WAV</th><th>WAS</th><th>JML</th>
      <th>WAV</th><th>WAS</th><th>JML</th>
      <th>WAV</th><th>WAS</th><th>JML</th><th>%</th>
      <th>WAV</th><th>WAS</th><th>JML</th><th>%</th>
      <th>WAV</th><th>WAS</th><th>JML</th>
    </tr>
  </thead>
  <tbody>
    {% for r in s.rows %}
    <tr class="row">
      <td class="b">{{ r.sn }}</td>
      <td class="txt">{{ r.somo }}</td>
      {{ numrow(r) }}
      <td class="comp{% if r.level %} lvl-{{ r.level | lower }}{% endif %}">{{ r.competency }}</td>
    </tr>
    {% endfor %}
    {% if s.total %}
    <tr class="row total">
      <td class="b" colspan="2">JUMLA</td>
      {{ numrow(s.total, total=True) }}
      <td></td>
      <td class="comp{% if s.total.level %} lvl-{{ s.total.level | lower }}{% endif %}">{{ s.total.competency }}</td>
    </tr>
    {% endif %}
  </tbody>
</table>
</body>
</html>
