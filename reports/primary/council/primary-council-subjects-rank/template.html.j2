<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ doc.document.report_title }}</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
{#
  Primary council subjects rank - per-subject performance grid (LEVEL + FUNCTION name).
  Fully self-contained (own template + own style.css, inline @font-face, no shared
  stylesheet). Data-driven and location-agnostic. KUNDI LA UMAHIRI (competency-level)
  background is the ONLY data-driven colour.

  A summary block (overall registered/sat + A-E grade split) sits above the main
  per-subject table (+ JUMLA total row). WAV/WAS/JML triplets throughout.
#}
<div class="titles">
  {% for line in doc.document.ministry %}
  <div class="hl ministry">{{ line }}</div>
  {% endfor %}
  <div class="hl exam-name">{{ doc.document.exam_name }}</div>
  <div class="hl report-title">{{ doc.document.report_title }}</div>
</div>

{# ---------- summary block ---------- #}
{% if doc.summary %}
<table class="grid summary">
  <colgroup>
    <col class="s-label">
    <col class="s-v"><col class="s-v"><col class="s-v">
    <col class="s-v"><col class="s-v"><col class="s-v"><col class="s-v">
    <col class="s-v"><col class="s-v"><col class="s-v">
    <col class="s-v"><col class="s-v"><col class="s-v">
    <col class="s-v"><col class="s-v"><col class="s-v">
    <col class="s-v"><col class="s-v"><col class="s-v">
    <col class="s-v"><col class="s-v"><col class="s-v">
    <col class="s-v"><col class="s-v"><col class="s-v">
  </colgroup>
  <tbody>
    <tr class="hg">
      <th rowspan="3" class="v-mid fill-shule">IDADI YA SHULE</th>
      <th colspan="7" class="grp">IDADI YA WATAHINIWA</th>
      <th colspan="17" class="grp">UFAULU KIMADARAJA</th>
    </tr>
    <tr class="hs">
      <th colspan="3" class="fill-reg">WALIOSAJILIWA</th>
      <th colspan="4" class="fill-fanya">WALIOFANYA</th>
      <th colspan="3" class="fill-a">A</th>
      <th colspan="3" class="fill-b">B</th>
      <th colspan="3" class="fill-c">C</th>
      <th colspan="3" class="fill-d">D</th>
      <th colspan="2" class="fill-ad">A-D</th>
      <th class="fill-e">E</th>
    </tr>
    <tr class="hf">
      <th>WAV</th><th>WAS</th><th>JML</th>
      <th>WAV</th><th>WAS</th><th>JML</th><th>%</th>
      <th>WAV</th><th>WAS</th><th>JML</th>
      <th>WAV</th><th>WAS</th><th>JML</th>
      <th>WAV</th><th>WAS</th><th>JML</th>
      <th>WAV</th><th>WAS</th><th>JML</th>
      <th>WAV</th><th>WAS</th>
      <th>JML</th><th>WAV</th>
    </tr>
    <tr class="row">
      <td class="b fill-shule">{{ doc.summary.shule }}</td>
      <td class="fill-reg">{{ doc.summary.reg_f }}</td><td class="fill-reg">{{ doc.summary.reg_m }}</td><td class="fill-reg b">{{ doc.summary.reg_t }}</td>
      <td class="fill-fanya">{{ doc.summary.fanya_f }}</td><td class="fill-fanya">{{ doc.summary.fanya_m }}</td><td class="fill-fanya b">{{ doc.summary.fanya_t }}</td><td class="fill-fanya b">{{ doc.summary.fanya_pct }}</td>
      <td class="fill-a">{{ doc.summary.a_f }}</td><td class="fill-a">{{ doc.summary.a_m }}</td><td class="fill-a b">{{ doc.summary.a_t }}</td>
      <td class="fill-b">{{ doc.summary.b_f }}</td><td class="fill-b">{{ doc.summary.b_m }}</td><td class="fill-b b">{{ doc.summary.b_t }}</td>
      <td class="fill-c">{{ doc.summary.c_f }}</td><td class="fill-c">{{ doc.summary.c_m }}</td><td class="fill-c b">{{ doc.summary.c_t }}</td>
      <td class="fill-d">{{ doc.summary.d_f }}</td><td class="fill-d">{{ doc.summary.d_m }}</td><td class="fill-d b">{{ doc.summary.d_t }}</td>
      <td class="fill-ad">{{ doc.summary.ad_f }}</td><td class="fill-ad">{{ doc.summary.ad_m }}</td><td class="fill-ad b">{{ doc.summary.ad_t }}</td>
      <td class="fill-e">{{ doc.summary.e_f }}</td>
    </tr>
    {% if doc.asilimia %}
    <tr class="pass">
      <td class="txt">ASILIMIA YA UFAULU(%)</td>
      <td colspan="7"></td>
      <td colspan="3" class="b">{{ doc.asilimia.a }}</td>
      <td colspan="3" class="b">{{ doc.asilimia.b }}</td>
      <td colspan="3" class="b">{{ doc.asilimia.c }}</td>
      <td colspan="3" class="b">{{ doc.asilimia.d }}</td>
      <td colspan="2" class="b">{{ doc.asilimia.ad }}</td>
      <td class="b">{{ doc.asilimia.e }}</td>
    </tr>
    {% endif %}
  </tbody>
</table>
{% endif %}

{% if doc.overall and doc.overall.gpa %}
<table class="grid overall-box">
  <colgroup><col class="ob-label"><col class="ob-gpa"><col class="ob-comp"></colgroup>
  <tr class="row">
    <td class="b">KUNDI LA UMAHIRI</td>
    <td class="b fill-wastani">{{ doc.overall.gpa }}</td>
    <td class="comp{% if doc.overall.level %} lvl-{{ doc.overall.level | lower }}{% endif %}">{{ doc.overall.competency }}</td>
  </tr>
</table>
{% endif %}

{% if doc.document.section_title %}
<table class="grid section-band">
  <colgroup><col></colgroup>
  <tr class="sect"><td class="b">{{ doc.document.section_title }}</td></tr>
</table>
{% endif %}

{# ---------- main per-subject table ---------- #}
<table class="grid main">
  <colgroup>
    <col><col>
    <col><col><col>  <col><col><col>  <col><col><col>
    <col><col><col>  <col><col><col>
    <col><col><col><col>  <col><col><col>
    <col><col><col>
  </colgroup>
  <thead>
    <tr class="hg">
      <th rowspan="3" class="v-mid">NA</th>
      <th rowspan="3" class="v-mid">SOMO</th>
      <th colspan="15" class="grp">UFAULU KIMADARAJA</th>
      <th colspan="4" class="grp fill-ad">WALIOFAULU (A-D)</th>
      <th colspan="3" class="grp fill-tot">JUMLA YA WATAHINIWA</th>
      <th rowspan="3" class="v-mid fill-wastani">WASTANI WA SOMO</th>
      <th rowspan="3" class="v-mid">NAFASI YA SOMO</th>
      <th rowspan="3" class="v-mid">KUNDI LA UMAHIRI</th>
    </tr>
    <tr class="hs">
      <th colspan="3" class="fill-a">A</th>
      <th colspan="3" class="fill-b">B</th>
      <th colspan="3" class="fill-c">C</th>
      <th colspan="3" class="fill-d">D</th>
      <th colspan="3" class="fill-e">E</th>
      <th colspan="4" class="fill-ad">A-D</th>
      <th colspan="3" class="fill-tot">JML</th>
    </tr>
    <tr class="hf">
      <th>WAV</th><th>WAS</th><th>JML</th>
      <th>WAV</th><th>WAS</th><th>JML</th>
      <th>WAV</th><th>WAS</th><th>JML</th>
      <th>WAV</th><th>WAS</th><th>JML</th>
      <th>WAV</th><th>WAS</th><th>JML</th>
      <th>WAV</th><th>WAS</th><th>JML</th><th>%</th>
      <th>WAV</th><th>WAS</th><th>JML</th>
    </tr>
  </thead>
  <tbody>
    {% for r in doc.rows %}
    <tr class="row">
      <td>{{ r.sn }}</td>
      <td class="txt">{{ r.subject }}</td>
      <td class="fill-a">{{ r.a_f }}</td><td class="fill-a">{{ r.a_m }}</td><td class="fill-a b">{{ r.a_t }}</td>
      <td class="fill-b">{{ r.b_f }}</td><td class="fill-b">{{ r.b_m }}</td><td class="fill-b b">{{ r.b_t }}</td>
      <td class="fill-c">{{ r.c_f }}</td><td class="fill-c">{{ r.c_m }}</td><td class="fill-c b">{{ r.c_t }}</td>
      <td class="fill-d">{{ r.d_f }}</td><td class="fill-d">{{ r.d_m }}</td><td class="fill-d b">{{ r.d_t }}</td>
      <td class="fill-e">{{ r.e_f }}</td><td class="fill-e">{{ r.e_m }}</td><td class="fill-e b">{{ r.e_t }}</td>
      <td class="fill-ad">{{ r.ad_f }}</td><td class="fill-ad">{{ r.ad_m }}</td><td class="fill-ad b">{{ r.ad_t }}</td><td class="fill-adpct b">{{ r.ad_pct }}</td>
      <td class="fill-tot">{{ r.tot_f }}</td><td class="fill-tot">{{ r.tot_m }}</td><td class="fill-tot b">{{ r.tot_t }}</td>
      <td class="b fill-wastani">{{ r.wastani }}</td>
      <td class="b">{{ r.nafasi }}</td>
      <td class="comp{% if r.level %} lvl-{{ r.level | lower }}{% endif %}">{{ r.competency }}</td>
    </tr>
    {% endfor %}
    {% if doc.total %}
    <tr class="row total">
      <td colspan="2" class="txt">JUMLA</td>
      <td class="fill-a">{{ doc.total.a_f }}</td><td class="fill-a">{{ doc.total.a_m }}</td><td class="fill-a b">{{ doc.total.a_t }}</td>
      <td class="fill-b">{{ doc.total.b_f }}</td><td class="fill-b">{{ doc.total.b_m }}</td><td class="fill-b b">{{ doc.total.b_t }}</td>
      <td class="fill-c">{{ doc.total.c_f }}</td><td class="fill-c">{{ doc.total.c_m }}</td><td class="fill-c b">{{ doc.total.c_t }}</td>
      <td class="fill-d">{{ doc.total.d_f }}</td><td class="fill-d">{{ doc.total.d_m }}</td><td class="fill-d b">{{ doc.total.d_t }}</td>
      <td class="fill-e">{{ doc.total.e_f }}</td><td class="fill-e">{{ doc.total.e_m }}</td><td class="fill-e b">{{ doc.total.e_t }}</td>
      <td class="fill-ad">{{ doc.total.ad_f }}</td><td class="fill-ad">{{ doc.total.ad_m }}</td><td class="fill-ad b">{{ doc.total.ad_t }}</td><td class="fill-adpct b">{{ doc.total.ad_pct }}</td>
      <td class="fill-tot">{{ doc.total.tot_f }}</td><td class="fill-tot">{{ doc.total.tot_m }}</td><td class="fill-tot b">{{ doc.total.tot_t }}</td>
      <td class="b fill-wastani">{{ doc.total.wastani }}</td>
      <td></td>
      <td class="comp{% if doc.total.level %} lvl-{{ doc.total.level | lower }}{% endif %}">{{ doc.total.competency }}</td>
    </tr>
    {% endif %}
  </tbody>
</table>
</body>
</html>
