<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ doc.document.report_title }}</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
{#
  Primary council all-schools rank - division/grade grid (LEVEL + FUNCTION name).
  Fully self-contained (own template + own style.css, inline @font-face, no shared
  stylesheet). Data-driven and location-agnostic. KUNDI LA UMAHIRI (competency-level)
  background is the ONLY data-driven colour. Content paginates across 3 pages; the
  column-header band repeats on every page via <thead> table-header-group.

  Columns: S/N | HALMASHAURI | KATA | JINA LA SHULE | UMILIKI
    WALIOSAJILIWA(WAV WAS JML) WALIOFANYA(WAV WAS JML) WASIOFANYA(WAV WAS JML)
    A(WAV WAS JML) B(WAV WAS JML) C(WAV WAS JML) D(WAV WAS JML)
    WALIOFAULU(A-D)(WAV WAS JML %) E(WAV WAS JML %)
    WASTANI WA SHULE /300 | KUNDI LA UMAHIRI | NAFASI WILAYA | NAFASI MKOA
#}
<div class="titles">
  {% for line in doc.document.ministry %}
  <div class="hl ministry">{{ line }}</div>
  {% endfor %}
  <div class="hl exam-name">{{ doc.document.exam_name }}</div>
  <div class="hl report-title">{{ doc.document.report_title }}</div>
</div>

{% macro cols() %}
<colgroup>
  <col><col><col><col><col>
  <col><col><col>  <col><col><col>  <col><col><col>
  <col><col><col>  <col><col><col>  <col><col><col>  <col><col><col>
  <col><col><col><col>  <col><col><col><col>
  <col><col><col><col>
</colgroup>
{% endmacro %}

{% macro nums(r) %}
  <td class="fill-reg">{{ r.reg_f }}</td><td class="fill-reg">{{ r.reg_m }}</td><td class="fill-reg b">{{ r.reg_t }}</td>
  <td class="fill-fanya">{{ r.fanya_f }}</td><td class="fill-fanya">{{ r.fanya_m }}</td><td class="fill-fanya b">{{ r.fanya_t }}</td>
  <td class="fill-sifanya">{{ r.sifanya_f }}</td><td class="fill-sifanya">{{ r.sifanya_m }}</td><td class="fill-sifanya b">{{ r.sifanya_t }}</td>
  <td class="fill-a">{{ r.a_f }}</td><td class="fill-a">{{ r.a_m }}</td><td class="fill-a b">{{ r.a_t }}</td>
  <td class="fill-b">{{ r.b_f }}</td><td class="fill-b">{{ r.b_m }}</td><td class="fill-b b">{{ r.b_t }}</td>
  <td class="fill-c">{{ r.c_f }}</td><td class="fill-c">{{ r.c_m }}</td><td class="fill-c b">{{ r.c_t }}</td>
  <td class="fill-d">{{ r.d_f }}</td><td class="fill-d">{{ r.d_m }}</td><td class="fill-d b">{{ r.d_t }}</td>
  <td class="fill-ad">{{ r.ad_f }}</td><td class="fill-ad">{{ r.ad_m }}</td><td class="fill-ad b">{{ r.ad_t }}</td><td class="fill-adpct b">{{ r.ad_pct }}</td>
  <td class="fill-e">{{ r.e_f }}</td><td class="fill-e">{{ r.e_m }}</td><td class="fill-e b">{{ r.e_t }}</td><td class="fill-e b">{{ r.e_pct }}</td>
{% endmacro %}

{% macro fmt_heads() %}
<tr class="hf">
  <th>WAV</th><th>WAS</th><th>JML</th>
  <th>WAV</th><th>WAS</th><th>JML</th>
  <th>WAV</th><th>WAS</th><th>JML</th>
  <th>WAV</th><th>WAS</th><th>JML</th>
  <th>WAV</th><th>WAS</th><th>JML</th>
  <th>WAV</th><th>WAS</th><th>JML</th>
  <th>WAV</th><th>WAS</th><th>JML</th>
  <th>WAV</th><th>WAS</th><th>JML</th><th>%</th>
  <th>WAV</th><th>WAS</th><th>JML</th><th>%</th>
</tr>
{% endmacro %}

{% if doc.summary %}
<table class="grid summary">
  {{ cols() }}
  <tbody>
    <tr class="hg">
      <th rowspan="3" colspan="5" class="grp v-mid fill-sn">IDADI YA SHULE</th>
      <th colspan="9" class="grp">IDADI YA WATAHINIWA</th>
      <th colspan="18" class="grp">UFAULU KIMADARAJA</th>
      <th rowspan="3" class="grp v-mid fill-wastani">WASTANI WA SHULE /300</th>
      <th rowspan="3" colspan="3" class="grp v-mid">KUNDI LA UMAHIRI</th>
    </tr>
    <tr class="hs">
      <th colspan="3" class="fill-reg">WALIOSAJILIWA</th>
      <th colspan="3" class="fill-fanya">WALIOFANYA</th>
      <th colspan="3" class="fill-sifanya">WASIOFANYA</th>
      <th colspan="3" class="fill-a">A</th>
      <th colspan="3" class="fill-b">B</th>
      <th colspan="3" class="fill-c">C</th>
      <th colspan="3" class="fill-d">D</th>
      <th colspan="4" class="fill-ad">WALIOFAULU(A-D)</th>
      <th colspan="4" class="fill-e">E</th>
    </tr>
    {{ fmt_heads() }}
    <tr class="row srow">
      <td colspan="5" class="b fill-sn">{{ doc.summary.shule }}</td>
      {{ nums(doc.summary) }}
      <td class="b fill-wastani">{{ doc.summary.wastani }}</td>
      <td colspan="3"></td>
    </tr>
    {% if doc.pct_pass %}
    <tr class="pass">
      <td colspan="5" class="txt">ASILIMIA(%)</td>
      <td colspan="3"></td>
      <td colspan="3" class="b">{{ doc.pct_pass.fanya }}</td>
      <td colspan="3" class="b">{{ doc.pct_pass.sifanya }}</td>
      <td colspan="3" class="b">{{ doc.pct_pass.a }}</td>
      <td colspan="3" class="b">{{ doc.pct_pass.b }}</td>
      <td colspan="3" class="b">{{ doc.pct_pass.c }}</td>
      <td colspan="3" class="b">{{ doc.pct_pass.d }}</td>
      <td colspan="4" class="b">{{ doc.pct_pass.ad }}</td>
      <td colspan="4" class="b">{{ doc.pct_pass.e }}</td>
      <td colspan="4"></td>
    </tr>
    {% endif %}
  </tbody>
</table>
{% endif %}

<table class="grid main">
  {{ cols() }}
  <thead>
    <tr class="hg">
      <th rowspan="3" class="v-mid">S/N</th>
      <th rowspan="3" class="v-mid">HALMASHAURI</th>
      <th rowspan="3" class="v-mid">KATA</th>
      <th rowspan="3" class="v-mid">JINA LA SHULE</th>
      <th rowspan="3" class="v-mid">UMILIKI</th>
      <th colspan="9" class="grp">IDADI YA WATAHINIWA</th>
      <th colspan="18" class="grp">UFAULU KIMADARAJA</th>
      <th rowspan="3" class="grp v-mid fill-wastani">WASTANI WA SHULE /300</th>
      <th rowspan="3" class="grp v-mid">KUNDI LA UMAHIRI</th>
      <th rowspan="3" class="v-mid">NAFASI WILAYA</th>
      <th rowspan="3" class="v-mid">NAFASI MKOA</th>
    </tr>
    <tr class="hs">
      <th colspan="3" class="fill-reg">WALIOSAJILIWA</th>
      <th colspan="3" class="fill-fanya">WALIOFANYA</th>
      <th colspan="3" class="fill-sifanya">WASIOFANYA</th>
      <th colspan="3" class="fill-a">A</th>
      <th colspan="3" class="fill-b">B</th>
      <th colspan="3" class="fill-c">C</th>
      <th colspan="3" class="fill-d">D</th>
      <th colspan="4" class="fill-ad">WALIOFAULU(A-D)</th>
      <th colspan="4" class="fill-e">E</th>
    </tr>
    {{ fmt_heads() }}
  </thead>
  <tbody>
    {% for r in doc.rows %}
    <tr class="row">
      <td class="fill-sn">{{ r.sn }}</td>
      <td class="txt">{{ r.council }}</td>
      <td class="txt">{{ r.ward }}</td>
      <td class="txt">{{ r.school }}</td>
      <td class="txt">{{ r.ownership }}</td>
      {{ nums(r) }}
      <td class="b fill-wastani">{{ r.wastani }}</td>
      <td class="comp{% if r.level %} lvl-{{ r.level | lower }}{% endif %}">{{ r.competency }}</td>
      <td class="b">{{ r.nw }}</td>
      <td class="b">{{ r.nm }}</td>
    </tr>
    {% endfor %}
    {% if doc.total %}
    <tr class="row total">
      <td colspan="5" class="txt">JUMLA</td>
      {{ nums(doc.total) }}
      <td class="b fill-wastani">{{ doc.total.wastani }}</td>
      <td class="comp{% if doc.total.level %} lvl-{{ doc.total.level | lower }}{% endif %}">{{ doc.total.competency }}</td>
      <td class="b">{{ doc.total.nw }}</td>
      <td class="b">{{ doc.total.nm }}</td>
    </tr>
    {% endif %}
  </tbody>
</table>
</body>
</html>
