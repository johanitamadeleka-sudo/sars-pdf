<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
{# grid rules painted as filled rects like the original (sars_pdf/rules.py) #}
<meta name="sars-pdf:rules" content="filled">
<title>{{ doc.document.report_title }}</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
{#
  Council schools rank - overall division grid (LEVEL + FUNCTION name). Fully self-contained
  (own template + own style.css, inline @font-face, no shared stylesheet). Data-driven and
  location-agnostic. Competency-level background is the ONLY data-driven colour.

  The page holds TWO independent tables, each with its OWN grid measured from the original:

  1. SUMMARY block (x 64.32 .. 754.08, 35 columns). It is NOT the per-school grid: it starts
     at the SCHOOL NAME boundary, has a rotated SUMMARY PERFORMANCE label + a NO. OF SCHOOLS
     column instead of S/NO. WARD SCHOOL OWNERSHIP, has no C/RANK / R/RANK columns, and its
     own header topology (two empty cells over REG F/M, NUMBER OF CANDIDATES over REG T..SAT %,
     a GPA PERFORMANCE group, GPA + COMPENTENCY LEVEL spanning 2 bands) and own fills.
         LABEL | NO.SCHOOLS | REGISTERED(F M T) SAT(F M T %) | I II III IV (F M T)
         0 I-III I-IV (F M T %) | GPA | COMPENTENCY LEVEL           + a % PASS row
  2. PER-SCHOOL table (x 13.44 .. 779.52, 39 columns) + TOTAL row:
         S/NO. | WARD | SCHOOL NAME | OWNERSHIP | REGISTERED(F M T) | SAT(F M T %)
         I(F M T) II(F M T) III(F M T) IV(F M T) 0(F M T %) I-III(F M T %) I-IV(F M T %)
         GPA | COMPETENCY LEVEL | C/RANK | R/RANK

  Column widths are the measured distances between the original's border centres and live
  HERE (one place) so the <col> widths and the shrink-to-fit widths can never disagree.
  fit() (sars_pdf/fit.py) shrinks a value only when it would not fit its fixed-pitch cell.
#}
{%- set MAIN_COLS = [12.84, 38.04, 50.78, 37.02,
    13.86, 16.56, 19.56,  16.56, 16.56, 16.59, 19.62,
    16.5, 13.2, 16.56,  13.2, 13.2, 19.56,  13.2, 13.2, 19.56,  16.58, 16.56, 16.62,
    19.5, 13.2, 16.56, 19.62,  16.5, 16.56, 16.56, 19.65,  16.5, 16.56, 16.56, 19.62,
    26.1, 61.22, 9.84, 15.6] %}
{%- set SUM_COLS = [50.78, 36.96,
    13.92, 16.56, 19.56,  16.56, 16.56, 16.59, 19.56,
    16.56, 13.2, 16.56,  13.2, 13.2, 19.56,  13.2, 13.2, 19.56,  16.58, 16.56, 16.56,
    19.56, 13.2, 16.56, 19.56,  16.56, 16.56, 16.56, 19.59,  16.56, 16.56, 16.56, 19.56,
    26.16, 61.22] %}
{#- numeric grid columns REG F .. GPA (per-school cols 5..36, summary cols 3..34):
    key, weight, per-school fill, TOTAL-row fill, thick group line on the left -#}
{%- set NUM = [
    ('reg_f', 'b', '', '', 'tl'), ('reg_m', 'b', '', '', ''), ('reg_t', 'b', '', '', ''),
    ('sat_f', 'b', '', '', ''), ('sat_m', 'b', '', '', ''), ('sat_t', 'b', '', '', ''),
    ('sat_pct', 'b', 'f-satp', 'f-satp', ''),
    ('i_f', '', '', '', 'tl'), ('i_m', '', '', '', ''), ('i_t', 'b', 'f-t', 'f-t', ''),
    ('ii_f', '', '', '', ''), ('ii_m', '', '', '', ''), ('ii_t', 'b', 'f-t', 'f-t', ''),
    ('iii_f', '', '', '', ''), ('iii_m', '', '', '', ''), ('iii_t', 'b', 'f-t', 'f-t', ''),
    ('iv_f', '', '', '', ''), ('iv_m', '', '', '', ''), ('iv_t', 'b', 'f-t', 'f-t', ''),
    ('z_f', 'b', 'f-z', '', 'tl'), ('z_m', 'b', 'f-z', '', ''), ('z_t', 'b', 'f-z', '', ''),
    ('z_pct', 'b', 'f-zp', 'f-zp', ''),
    ('d3_f', 'b', 'f-d3', 'f-d3', 'tl'), ('d3_m', 'b', 'f-d3', 'f-d3', ''), ('d3_t', 'b', 'f-d3', 'f-d3', ''),
    ('d3_pct', 'b', 'f-d3p', 'f-d3p', ''),
    ('d4_f', 'b', '', '', 'tl'), ('d4_m', 'b', '', '', ''), ('d4_t', 'b', '', '', ''),
    ('d4_pct', 'b', 'f-t', '', ''),
    ('gpa', 'b', '', '', 'tl'),
] %}
{#- text box of a cell = column width - border halves - horizontal padding (see style.css) -#}
{%- set PAD_NUM = 1.1 %}
{%- set PAD_TXT = 1.3 %}

<div class="titles">
  {% for line in doc.document.ministry %}
  <div class="hl">{{ line }}</div>
  {% endfor %}
  <div class="hl">{{ doc.document.exam_name }}</div>
  <div class="hl report-title">{{ doc.document.report_title }}</div>
</div>

{# ================= TABLE 1: SUMMARY block (own 35-column grid) ================= #}
{% if doc.summary %}
{% set s = doc.summary %}
{% set s_lvl = level(s.competency, s.gpa) %}
<table class="grid summary">
  <colgroup>{% for w in SUM_COLS %}<col style="width:{{ w }}pt">{% endfor %}</colgroup>
  <tbody>
    <tr class="s1">
      {# The original forces this label onto 3 rotated lines of <=26pt; PERFORMANCE does not
         fit one line, so Excel breaks it inside the word. Reproduced as printed. #}
      <th rowspan="4" class="s-label"><div class="rot"><span>SUMMARY<br>PERFORMANC<br>E</span></div></th>
      <th rowspan="3" class="s-nos"><div class="anc"><span>NO. OF SCHOOLS<br>IN COUNCIL</span></div></th>
      <th></th><th></th>
      <th colspan="5" class="s-cand f-s-cand">NUMBER OF CANDIDATES</th>
      <th colspan="24" class="s-div">DIVISION PERFORMANCE</th>
      <th colspan="2" class="s-gpa f-s-gpa">GPA PERFORMANCE</th>
    </tr>
    <tr class="s2">
      <th colspan="3" class="s-reg f-s-reg">REGISTERED</th>
      <th colspan="4" class="s-sat f-s-sat">SAT</th>
      <th colspan="3" class="s-rn">I</th>
      <th colspan="3" class="s-rn">II</th>
      <th colspan="3" class="s-rn">III</th>
      <th colspan="3" class="s-rn-lo">IV</th>
      <th colspan="4" class="s-rn-0">0</th>
      <th colspan="4" class="s-rn-lo">I-III</th>
      <th colspan="4" class="s-rn-iv">I-IV</th>
      <th rowspan="2" class="s-gpah f-s-gpah"><div class="anc"><span>GPA</span></div></th>
      <th rowspan="2" class="s-comph f-s-gpah"><div class="anc"><span>COMPENTENCY LEVEL</span></div></th>
    </tr>
    <tr class="s3">
      <th class="s-fmt f-s-fmt">F</th><th class="s-fmt f-s-fmt">M</th><th class="s-fmt f-s-fmt">T</th>
      <th class="s-fmt f-s-fmt">F</th><th class="s-fmt f-s-fmt">M</th><th class="s-fmt f-s-fmt">T</th>
      <th class="s-pct s-pct-sat f-s-satp">%</th>
      {% for _ in range(4) %}
      <th class="s-fmt f-s-fmt">F</th><th class="s-fmt f-s-fmt">M</th><th class="s-fmt f-s-fmt">T</th>
      {% endfor %}
      <th class="s-fmt f-s-z">F</th><th class="s-fmt f-s-z">M</th><th class="s-fmt f-s-z">T</th><th class="s-pct f-s-z">%</th>
      <th class="s-fmt f-s-d3">F</th><th class="s-fmt f-s-d3">M</th><th class="s-fmt f-s-d3">T</th><th class="s-pct f-s-d3p">%</th>
      <th class="s-fmt f-s-d4">F</th><th class="s-fmt f-s-d4">M</th><th class="s-fmt f-s-d4">T</th><th class="s-pct f-s-fmt">%</th>
    </tr>
    <tr class="s4">
      <td class="s-val"{{ fit(s.no_schools, SUM_COLS[1] - PAD_NUM, 4.8, bold=True) }}>{{ s.no_schools }}</td>
      {% for key, wt, fb, ft, tl in NUM %}
      {% set fill = 'f-s-vz' if key.startswith('z_') else ('f-s-vd3' if key.startswith('d3_') else '') %}
      <td class="s-val {{ fill }}"{{ fit(s[key], SUM_COLS[2 + loop.index0] - PAD_NUM, 4.8, bold=True) }}>{{ s[key] }}</td>
      {% endfor %}
      <td class="s-comp{% if s_lvl %} lvl-{{ s_lvl | lower }}{% endif %}"{{ fit(s.competency, SUM_COLS[34] - PAD_TXT, 4.2, bold=True) }}>{{ s.competency }}</td>
    </tr>
    {% set p = doc.pct_pass or {} %}
    <tr class="s5">
      <td colspan="9" class="s-passl">% PASS</td>
      <td colspan="3" class="s-passv">{{ p.i }}</td>
      <td colspan="3" class="s-passv">{{ p.ii }}</td>
      <td colspan="3" class="s-passv">{{ p.iii }}</td>
      <td colspan="3" class="s-passv">{{ p.iv }}</td>
      <td colspan="4" class="s-passv">{{ p.z }}</td>
      <td colspan="4" class="s-passv">{{ p.d3 }}</td>
      <td colspan="4" class="s-passv">{{ p.d4 }}</td>
      <td colspan="2"></td>
    </tr>
  </tbody>
</table>
{% endif %}

{# ================= TABLE 2: PER-SCHOOL table (own 39-column grid) ================= #}
<table class="grid main">
  <colgroup>{% for w in MAIN_COLS %}<col style="width:{{ w }}pt">{% endfor %}</colgroup>
  <thead>
    <tr class="h1">
      <th rowspan="3" class="h-lbl h-sn tl tb">S/NO.</th>
      <th rowspan="3" class="h-lbl h-ward tb">WARD</th>
      <th rowspan="3" class="h-lbl h-ctr tb">SCHOOL NAME</th>
      <th rowspan="3" class="h-lbl h-ctr tb">OWNERSHIP</th>
      <th colspan="7" class="h-cand f-h-cand tl">NUMBER OF CANDIDATES</th>
      <th colspan="24" class="h-div tl">DIVISION PERFORMANCE</th>
      <th rowspan="3" class="h-gpa f-h-gpa tl tb"><div class="anc"><span>GPA</span></div></th>
      <th rowspan="3" class="h-comp tb"><div class="anc"><span>COMPETENCY LEVEL</span></div></th>
      <th rowspan="3" class="h-rank f-h-rank tb"><div class="rot"><span>C/RANK</span></div></th>
      <th rowspan="3" class="h-rank h-rrank f-h-rank tb"><div class="rot"><span>R/RANK</span></div></th>
    </tr>
    <tr class="h2">
      <th colspan="3" class="h-grp tl">REGISTERED</th>
      <th colspan="4" class="h-grp">SAT</th>
      <th colspan="3" class="h-rn tl">I</th>
      <th colspan="3" class="h-rn">II</th>
      <th colspan="3" class="h-rn">III</th>
      <th colspan="3" class="h-rn-lo">IV</th>
      <th colspan="4" class="h-rn">0</th>
      <th colspan="4" class="h-rn-lo">I-III</th>
      <th colspan="4" class="h-rn-lo">I-IV</th>
    </tr>
    <tr class="h3">
      <th class="h-fmt f-h-reg tl tb">F</th><th class="h-fmt f-h-reg tb">M</th><th class="h-fmt f-h-reg tb">T</th>
      <th class="h-fmt f-h-sat tb">F</th><th class="h-fmt f-h-sat tb">M</th><th class="h-fmt f-h-sat tb">T</th>
      <th class="h-pct-sat f-h-satp tb">%</th>
      {% for _ in range(4) %}
      <th class="h-fmt f-h-div tb{% if loop.first %} tl{% endif %}">F</th><th class="h-fmt f-h-div tb">M</th><th class="h-fmt f-h-div tb">T</th>
      {% endfor %}
      <th class="h-fmt f-h-z tb">F</th><th class="h-fmt f-h-z tb">M</th><th class="h-fmt f-h-z tb">T</th><th class="h-pct f-h-z tb">%</th>
      <th class="h-fmt f-h-d3 tl tb">F</th><th class="h-fmt f-h-d3 tb">M</th><th class="h-fmt f-h-d3 tb">T</th><th class="h-pct f-h-d3 tb">%</th>
      <th class="h-fmt f-h-d4 tb">F</th><th class="h-fmt f-h-d4 tb">M</th><th class="h-fmt f-h-d4 tb">T</th><th class="h-pct f-h-d4p tb">%</th>
    </tr>
  </thead>
  <tbody>
    {% for r in doc.rows %}
    <tr class="row">
      <td class="c-sn"{{ fit(r.sn, MAIN_COLS[0] - PAD_NUM, 3.96) }}>{{ r.sn }}</td>
      <td class="txt"{{ fit(r.ward, MAIN_COLS[1] - PAD_TXT, 3.96) }}>{{ r.ward }}</td>
      <td class="txt"{{ fit(r.school, MAIN_COLS[2] - PAD_TXT, 3.96) }}>{{ r.school }}</td>
      <td class="txt"{{ fit(r.ownership, MAIN_COLS[3] - PAD_TXT, 3.96) }}>{{ r.ownership }}</td>
      {% for key, wt, fb, ft, tl in NUM %}
      <td class="{{ wt }} {{ fb }} {{ tl }}"{{ fit(r[key], MAIN_COLS[4 + loop.index0] - PAD_NUM, 4.2, bold=(wt == 'b')) }}>{{ r[key] }}</td>
      {% endfor %}
      <td class="comp{% if r.level %} lvl-{{ r.level | lower }}{% endif %}"{{ fit(r.competency, MAIN_COLS[36] - PAD_TXT, 3.96, bold=True) }}>{{ r.competency }}</td>
      <td class="rk f-crank"{{ fit(r.crank, MAIN_COLS[37] - PAD_NUM, 3.96, bold=True) }}>{{ r.crank }}</td>
      <td class="rk"{{ fit(r.rrank, MAIN_COLS[38] - PAD_NUM, 3.96, bold=True) }}>{{ r.rrank }}</td>
    </tr>
    {% endfor %}
    {% if doc.total %}
    {% set t = doc.total %}
    {% set t_lvl = level(t.competency, t.gpa) %}
    <tr class="total">
      <td colspan="4" class="t-label">TOTAL</td>
      {% for key, wt, fb, ft, tl in NUM %}
      <td class="t-num {{ ft }} {{ tl }}{% if not loop.last %} tt tb{% endif %}"{{ fit(t[key], MAIN_COLS[4 + loop.index0] - PAD_NUM, 4.2, bold=True) }}>{{ t[key] }}</td>
      {% endfor %}
      {# in the TOTAL row the competency cell also covers the C/RANK column #}
      <td colspan="2" class="t-comp{% if t_lvl %} lvl-{{ t_lvl | lower }}{% endif %}"{{ fit(t.competency, MAIN_COLS[36] + MAIN_COLS[37] - PAD_TXT, 4.2, bold=True) }}>{{ t.competency }}</td>
      <td class="t-rrank f-t-rrank tl tt tb"{{ fit(t.rrank, MAIN_COLS[38] - PAD_NUM, 3.6, bold=True) }}>{{ t.rrank }}</td>
    </tr>
    {% endif %}
  </tbody>
</table>
</body>
</html>
