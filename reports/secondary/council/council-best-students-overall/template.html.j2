<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ doc.document.report_title }}</title>
<link rel="stylesheet" href="style.css">
</head>
<body{% if doc.document.wrap_text %} class="wrap-text"{% endif %}>
{#
  Council best students overall (LEVEL + FUNCTION name). Section-centric: stacked top-10
  tables. Fully self-contained (own template + own style.css, inline @font-face, no shared
  stylesheet). Data-driven and location-agnostic. Competency-level colour is not used here
  (no competency column); every colour/fill is a fixed identical palette.

  Columns: C/NO | SCHOOL NAME | CANDIDATE FULL NAME | SEX | AGGT | DIVISION | POSITION
           | DETAILED SUBJECTS
#}
<div class="titles">
  {% for line in doc.document.ministry %}
  <div class="hl ministry">{{ line }}</div>
  {% endfor %}
  <div class="hl exam-name">{{ doc.document.exam_name }}</div>
</div>

{% set ROOM, SIZE, LS, WS = 413.5, 6.7, -0.15, 0.0 %}{# = td.det in style.css #}
{#
  DETAILED SUBJECTS never loses an entry: wrap() (sars_pdf/fit.py) keeps a line that fits,
  shrinks one that is at most 2.5% too wide (as the Excel originals do), and otherwise
  breaks it between "SHORT NAME - MARKS'GRADE'" entries onto extra lines - the row grows.
  ROOM = column width - 2 x 2pt padding - 0.5pt collapsed border.
#}
{% macro detailed(text) %}{% set w = wrap(text, ROOM, SIZE, letter_spacing=LS, word_spacing=WS, unit="subjects", max_shrink=0.975) %}<td class="txt det{% if w.lines | length > 1 %} det-wrap{% endif %}"{% if w.size < SIZE %} style="font-size:{{ '%.2f' | format(w.size) }}pt"{% endif %}>{% for line in w.lines %}{% if not loop.first %}<br>{% endif %}{{ line }}{% endfor %}</td>{% endmacro %}
{% set bpp = doc.document.blocks_per_page | default(2) %}
{% for s in doc.sections %}
{# page grouping is data-driven (blocks_per_page, default 2), not a hard-coded section
   index. A block with >10 rows (ties) is not force-kept-together so it may flow across a
   page break with its <thead> repeated instead of overflowing. #}
<div class="section{% if not loop.first and not s.allow_break %} keep-together{% endif %}{% if not loop.first and loop.index0 % bpp == 0 %} page-top{% endif %}">
  {% if s.banner %}
  <div class="banner">{{ doc.document.report_title }}</div>
  {% else %}
  <div class="sec-title">{{ s.title }}</div>
  {% endif %}
  <table class="students">
    <colgroup>
      <col class="w-cno"><col class="w-school"><col class="w-cand">
      <col class="w-sex"><col class="w-aggt"><col class="w-div"><col class="w-pos">
      <col class="w-det">
    </colgroup>
    <thead>
      <tr>
        <th rowspan="2" class="v-mid">C/NO</th>
        <th rowspan="2" class="v-mid">SCHOOL NAME</th>
        <th rowspan="2" class="v-mid">CANDIDATE FULL  NAME</th>
        <th class="vcol fill-sex-h"><div class="vert"><span>SEX</span></div></th>
        <th class="vcol fill-ag-h"><div class="vert"><span>AGGT</span></div></th>
        <th class="vcol fill-ag-h"><div class="vert"><span>DIVISION</span></div></th>
        <th class="vcol fill-pos-h"><div class="vert"><span>POSITION</span></div></th>
        <th rowspan="2" class="v-mid">DETAILED SUBJECTS</th>
      </tr>
      <tr class="h-spacer"><th></th><th></th><th></th><th></th></tr>
    </thead>
    <tbody>
      {% for r in s.rows %}
      <tr class="row">
        <td class="c-cno">{{ r.cno }}</td>
        <td class="txt">{{ r.school }}</td>
        <td class="txt">{{ r.candidate }}</td>
        <td>{{ r.sex }}</td>
        <td>{{ r.aggt }}</td>
        <td>{{ r.division }}</td>
        <td class="c-pos">{{ r.position }}</td>
        {{ detailed(r.detailed) }}
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}
</body>
</html>
