<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
{# Excel-export original: paint grid rules as crisp filled rects, not strokes (sars_pdf/rules.py) #}
<meta name="sars-pdf:rules" content="filled">
<title>{{ doc.document.report_title }}</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
{#
  Council top-10 schools (LEVEL + FUNCTION name). Section-centric: stacked top-10
  division-performance tables. Fully self-contained (own template + own style.css, inline
  @font-face, no shared stylesheet). Data-driven and location-agnostic. The COMPETENCY LEVEL
  background is the ONLY data-driven colour; all other fills are a fixed palette.

  Columns: S/NO. | SCHOOL NAME | REGISTERED(F M T) | SAT(F M T %)
    I(F M T) II(F M T) III(F M T) IV(F M T) 0(F M T %) I-III(F M T %) I-IV(F M T %)
    GPA | COMPETENCY | C/RANK
#}
<div class="titles">
  {% for line in doc.document.ministry %}
  <div class="hl ministry">{{ line }}</div>
  {% endfor %}
  <div class="hl exam-name">{{ doc.document.exam_name }}</div>
  <div class="hl report-title">{{ doc.document.report_title }}</div>
</div>

{% macro nums(r) %}
  <td>{{ r.reg_f }}</td><td>{{ r.reg_m }}</td><td class="b">{{ r.reg_t }}</td>
  <td class="fill-sat">{{ r.sat_f }}</td><td class="fill-sat">{{ r.sat_m }}</td><td class="b fill-sat">{{ r.sat_t }}</td><td class="b fill-satpct">{{ r.sat_pct }}</td>
  <td>{{ r.i_f }}</td><td>{{ r.i_m }}</td><td class="b">{{ r.i_t }}</td>
  <td>{{ r.ii_f }}</td><td>{{ r.ii_m }}</td><td class="b">{{ r.ii_t }}</td>
  <td>{{ r.iii_f }}</td><td>{{ r.iii_m }}</td><td class="b">{{ r.iii_t }}</td>
  <td>{{ r.iv_f }}</td><td>{{ r.iv_m }}</td><td class="b">{{ r.iv_t }}</td>
  <td class="fill-0">{{ r.z_f }}</td><td class="fill-0">{{ r.z_m }}</td><td class="b fill-0">{{ r.z_t }}</td><td class="b fill-0pct">{{ r.z_pct }}</td>
  <td class="fill-3">{{ r.d3_f }}</td><td class="fill-3">{{ r.d3_m }}</td><td class="b fill-3">{{ r.d3_t }}</td><td class="b fill-3pct">{{ r.d3_pct }}</td>
  <td class="fill-4">{{ r.d4_f }}</td><td class="fill-4">{{ r.d4_m }}</td><td class="b fill-4">{{ r.d4_t }}</td><td class="b fill-4pct">{{ r.d4_pct }}</td>
  <td class="b fill-4pct">{{ r.gpa }}</td>
{% endmacro %}

{% set bpp = doc.document.blocks_per_page | default(2) %}
{% for s in doc.sections %}
{# page break before a block whose position starts a new page-group of `bpp` blocks;
   data-driven (blocks_per_page), not a hard-coded section index. A block that itself
   overflows a page still flows onto the next page with its <thead> repeated. #}
<div class="section{% if not loop.first and loop.index0 % bpp == 0 %} page-top{% endif %}">
  <div class="sec-title">{{ s.title }}</div>
  <table class="grid">
    <colgroup>
      <col class="w-sn"><col class="w-school">
      <col class="t"><col class="t"><col class="t">
      <col class="t"><col class="t"><col class="t"><col class="p">
      <col class="t"><col class="t"><col class="t">
      <col class="t"><col class="t"><col class="t">
      <col class="t"><col class="t"><col class="t">
      <col class="t"><col class="t"><col class="t">
      <col class="t"><col class="t"><col class="t"><col class="p">
      <col class="t"><col class="t"><col class="t"><col class="p">
      <col class="t"><col class="t"><col class="t"><col class="p">
      <col class="w-gpa"><col class="w-comp"><col class="w-crank">
    </colgroup>
    <thead>
      <tr class="hg">
        <th rowspan="3" class="c-sn">S/NO.</th>
        <th rowspan="3" class="v-mid">SCHOOL NAME</th>
        <th colspan="7" class="grp">NUMBER OF CANDIDATES</th>
        <th colspan="24" class="grp">DIVISION PERFORMANCE</th>
        <th rowspan="3" class="v-mid fill-gpa-h">GPA</th>
        <th rowspan="3" class="v-mid comp-h">COMPETENCY LEVEL</th>
        <th rowspan="3" class="crank-h fill-crank-h"><div class="vert"><span>C/RANK</span></div></th>
      </tr>
      <tr class="hs">
        <th colspan="3" class="fill-reg-h">REGISTERED</th>
        <th colspan="3" class="fill-sat-h">SAT</th><th class="fill-satpct">%</th>
        <th colspan="3" class="fill-div-h">I</th><th colspan="3" class="fill-div-h">II</th><th colspan="3" class="fill-div-h">III</th><th colspan="3" class="fill-div-h">IV</th>
        <th colspan="3" class="fill-0-h">0</th><th class="fill-0pct-h"></th>
        <th colspan="3" class="fill-3-h">I-III</th><th class="fill-3pct-h"></th>
        <th colspan="3" class="fill-4-h">I-IV</th><th class="fill-4pct"></th>
      </tr>
      <tr class="hf">
        <th>F</th><th>M</th><th>T</th>
        <th class="fill-sat">F</th><th class="fill-sat">M</th><th class="fill-sat">T</th><th class="fill-satpct">%</th>
        <th>F</th><th>M</th><th>T</th><th>F</th><th>M</th><th>T</th>
        <th>F</th><th>M</th><th>T</th><th>F</th><th>M</th><th>T</th>
        <th class="fill-0">F</th><th class="fill-0">M</th><th class="fill-0">T</th><th class="fill-0pct">%</th>
        <th class="fill-3">F</th><th class="fill-3">M</th><th class="fill-3">T</th><th class="fill-3pct">%</th>
        <th class="fill-4">F</th><th class="fill-4">M</th><th class="fill-4">T</th><th class="fill-4pct">%</th>
      </tr>
    </thead>
    <tbody>
      {% for r in s.rows %}
      <tr class="row">
        <td class="c-sn">{{ r.sn }}</td>
        <td class="txt"{{ fit(r.school, 56.0, 6.1) }}>{{ r.school }}</td>
        {{ nums(r) }}
        <td class="txt comp{% if r.level %} lvl-{{ r.level | lower }}{% endif %}"{{ fit(r.competency, 69.0, 5.9, bold=True) }}>{{ r.competency }}</td>
        <td class="b c-rank fill-crank">{{ r.crank }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}
</body>
</html>
