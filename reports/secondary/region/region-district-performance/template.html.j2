<body>
{% for s in doc.sections %}
{%- set reg = s.has_registered %}
{%- set lk = s.kind if (s.kind in LAYOUTS and ((LAYOUTS[s.kind].cols | length) == 37) == reg) else ('overall' if reg else 'percentage') %}
{%- set L = LAYOUTS[lk] %}
{%- set cols = L.cols %}
{%- set nums = NUMS if reg else (NUMS[:1] + NUMS[4:]) %}
{#- widths of the text boxes (column minus the padding/rule allowance) for fit() #}
{%- set C_COMP = cols | length - 2 %}
<section class="sec k-{{ lk }} kind-{{ s.kind or lk }}">
  <div class="titles">
    {% for line in doc.document.ministry %}
    <div class="hl">{{ line }}</div>
    {% endfor %}
    <div class="hl">{{ doc.document.exam_name }}</div>
  </div>
  <div class="band">{{ s.title }}</div>
  <table class="grid">
    <colgroup>{% for w in cols %}<col style="width:{{ w }}pt">{% endfor %}</colgroup>
    <thead>
      <tr class="h0">
        <th rowspan="2" class="h-sn"><div class="anc"><span>S/N</span></div></th>
        <th rowspan="2" class="h-dist"><div class="anc"><span>DISTRICT</span></div></th>
        <th rowspan="2" class="h-nos f-hnos"><div class="anc"><span>NUMBER OF<br>SCHOOLS</span></div></th>
        {% if reg %}<th colspan="3" class="g-reg">REGISTERED</th>{% endif %}
        <th colspan="4" class="g-sat">SAT</th>
        <th colspan="3" class="g-grp">I</th>
        <th colspan="3" class="g-grp">II</th>
        <th colspan="3" class="g-grp">III</th>
        <th colspan="3" class="g-grp">IV</th>
        <th colspan="4" class="g-grp">0</th>
        <th colspan="4" class="g-grp">I-III</th>
        <th colspan="4" class="g-grp">I-IV</th>
        <th rowspan="2" class="h-gpa"><div class="anc"><span>GPA</span></div></th>
        <th rowspan="2" class="h-comp"><div class="anc"><span>COMPETENCY LEVEL</span></div></th>
        <th rowspan="2" class="h-rank"><div class="anc"><span class="rot">RANK</span></div></th>
      </tr>
      <tr class="h1">
        {% for key, bold, fb, ft, grp, tl, ttl, lab, hf, htb in nums[1:-1] %}
        <th class="{{ 'spct' if key == 'sat_pct' else 'fmt' }}{% if htb %} tb{% endif %}{% if hf %} {{ hf }}{% endif %}">{{ lab }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for r in s.rows %}
      <tr class="row{% if loop.last %} last{% endif %}">
        <td class="sn"{{ fit(r.sn, cols[0] - 1.2, L.f.sn, family='Calibri') }}>{{ r.sn }}</td>
        <td class="dist"{{ fit(r.district, cols[1] - L.dx.dist - 0.6, L.f.b) }}>{{ r.district }}</td>
        {% for key, bold, fb, ft, grp, tl, ttl, lab, hf, htb in nums %}
        {%- set size = L.f.sch if key == 'schools' else L.f.b %}
        <td class="{{ 'sch' if key == 'schools' else ('n' ~ grp) }}{% if bold %} b{% endif %}{% if fb %} {{ fb }}{% endif %}{% if tl %} tl{% endif %}"{{ fit(r[key], cols[2 + loop.index0] - 1.4, size, bold=bold) }}>{{ r[key] }}</td>
        {% endfor %}
        <td class="comp{% if r.level %} lvl-{{ r.level | lower }}{% endif %}"{{ fit(r.competency, cols[C_COMP] - L.dx.comp - 0.6, L.f.b) }}>{{ r.competency }}</td>
        <td class="rk f-rank"{{ fit(r.rank, cols[-1] - 1.0, L.f.rk) }}>{{ r.rank }}</td>
      </tr>
      {% endfor %}
      {% if s.total %}
      {% set t = s.total %}
      {% set t_lvl = level(t.competency, t.gpa) %}
      <tr class="total">
        <td colspan="2" class="t-label">TOTAL</td>
        {% for key, bold, fb, ft, grp, tl, ttl, lab, hf, htb in nums %}
        {%- set size = L.f.tsch if key == 'schools' else L.f.tn %}
        <td class="{{ 't-sch' if key == 'schools' else 't-num' }}{% if grp == 'c' %} gc{% endif %} tt tb{% if ft %} {{ ft }}{% endif %}{% if ttl %} tl{% endif %}"{{ fit(t[key], cols[2 + loop.index0] - 1.6, size, family='Calibri', bold=True) }}>{{ t[key] }}</td>
        {% endfor %}
        <td class="t-comp tl{% if t_lvl %} lvl-{{ t_lvl | lower }}{% endif %}"{{ fit(t.competency, cols[C_COMP] - L.dx.tcomp - 0.6, L.f.tc, family='Calibri', bold=True) }}>{{ t.competency }}</td>
        <td class="t-rank">{{ t.rank }}</td>
      </tr>
      {% endif %}
    </tbody>
  </table>
</section>
{% endfor %}
</body>
</html>
