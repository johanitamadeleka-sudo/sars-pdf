<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Region district performance</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
{#
  Region district performance (LEVEL + FUNCTION name). Region-only report. Section-centric:
  5 stacked per-council/district division grids (one per page). Fully self-contained (own
  template + own style.css, inline @font-face, no shared stylesheet). Data-driven and
  location-agnostic. Competency-level background is the ONLY data-driven colour.

  OVERALL / GOVERNMENT / PRIVATE sections carry a REGISTERED group; BY PERCENTAGE / BY KPI
  omit it (has_registered flag). Columns:
    S/N | DISTRICT | NO. OF SCHOOLS | NUMBER OF CANDIDATES(REGISTERED F M T, SAT F M T %)
        | DIVISION PERFORMANCE(I,II,III,IV,0,I-III,I-IV F/M/T + %) | GPA | COMPETENCY | RANK
#}
{% macro nums(r, reg) %}
  <td class="b fill-sch">{{ r.schools }}</td>
  {% if reg %}<td>{{ r.reg_f }}</td><td>{{ r.reg_m }}</td><td class="b">{{ r.reg_t }}</td>{% endif %}
  <td>{{ r.sat_f }}</td><td>{{ r.sat_m }}</td><td class="b">{{ r.sat_t }}</td><td class="b fill-sat">{{ r.sat_pct }}</td>
  <td>{{ r.i_f }}</td><td>{{ r.i_m }}</td><td class="b">{{ r.i_t }}</td>
  <td>{{ r.ii_f }}</td><td>{{ r.ii_m }}</td><td class="b">{{ r.ii_t }}</td>
  <td>{{ r.iii_f }}</td><td>{{ r.iii_m }}</td><td class="b">{{ r.iii_t }}</td>
  <td>{{ r.iv_f }}</td><td>{{ r.iv_m }}</td><td class="b">{{ r.iv_t }}</td>
  <td>{{ r.z_f }}</td><td>{{ r.z_m }}</td><td class="b fill-0">{{ r.z_t }}</td><td class="b fill-0">{{ r.z_pct }}</td>
  <td>{{ r.d3_f }}</td><td>{{ r.d3_m }}</td><td class="b fill-3">{{ r.d3_t }}</td><td class="b fill-3">{{ r.d3_pct }}</td>
  <td>{{ r.d4_f }}</td><td>{{ r.d4_m }}</td><td class="b fill-4">{{ r.d4_t }}</td><td class="b fill-4">{{ r.d4_pct }}</td>
  <td class="b fill-gpa">{{ r.gpa }}</td>
{% endmacro %}

{% for s in doc.sections %}
{% set reg = s.has_registered %}
<div class="section{% if not loop.first %} own-page{% endif %}">
  <div class="titles">
    {% for line in doc.document.ministry %}
    <div class="hl ministry">{{ line }}</div>
    {% endfor %}
    <div class="hl exam-name">{{ doc.document.exam_name }}</div>
    <div class="hl sec-title">{{ s.title }}</div>
  </div>
  <table class="grid {% if reg %}full{% else %}pct{% endif %}">
    <colgroup>
      {% if reg %}
      {% for w in [20.5,49.5,28.5,18.1,17.9,17.6,18.1,17.9,17.9,29.5,15.0,14.8,14.7,14.8,14.8,14.7,14.8,14.7,14.8,17.9,17.9,17.6,15.0,14.8,14.7,26.3,15.0,17.9,17.9,28.6,18.2,17.8,17.9,26.4,24.0,57.4,14.9] %}<col style="width: {{ w }}pt">{% endfor %}
      {% else %}
      {% for w in [22.0,53.2,30.3,19.2,19.1,19.1,31.7,15.9,15.9,15.8,15.8,15.9,15.8,15.9,15.8,15.8,19.1,19.1,19.0,15.9,15.9,15.8,28.2,16.0,19.0,19.1,30.9,19.2,19.0,19.1,28.5,25.6,61.2,15.9] %}<col style="width: {{ w }}pt">{% endfor %}
      {% endif %}
    </colgroup>
    <thead>
      <tr class="hg">
        <th rowspan="3" class="c-sn">S/N</th>
        <th rowspan="3" class="v-mid">DISTRICT</th>
        <th rowspan="3" class="v-mid nowrap">NO. OF SCHOOLS</th>
        <th colspan="{% if reg %}7{% else %}4{% endif %}" class="grp fill-cand-h">NUMBER OF CANDIDATES</th>
        <th colspan="23" class="grp">DIVISION PERFORMANCE</th>
        <th rowspan="3" class="v-mid fill-gpa-h">GPA</th>
        <th rowspan="3" class="v-mid">COMPETENCY LEVEL</th>
        <th rowspan="3" class="rank-h"><div class="vert"><span>RANK</span></div></th>
      </tr>
      <tr class="hs">
        {% if reg %}<th colspan="3" class="fill-cand-h">REGISTERED</th>{% endif %}
        <th colspan="4" class="fill-cand-h">SAT</th>
        <th colspan="3">I</th><th colspan="3">II</th><th colspan="3">III</th><th colspan="3">IV</th>
        <th colspan="4" class="fill-0-h">0</th>
        <th colspan="4" class="fill-3-h">I-III</th>
        <th colspan="4" class="fill-4-h">I-IV</th>
      </tr>
      <tr class="hf">
        {% if reg %}<th>F</th><th>M</th><th>T</th>{% endif %}
        <th>F</th><th>M</th><th>T</th><th>%</th>
        <th>F</th><th>M</th><th>T</th><th>F</th><th>M</th><th>T</th>
        <th>F</th><th>M</th><th>T</th><th>F</th><th>M</th><th>T</th>
        <th>F</th><th>M</th><th>T</th><th>%</th>
        <th>F</th><th>M</th><th>T</th><th>%</th>
        <th>F</th><th>M</th><th>T</th><th>%</th>
      </tr>
    </thead>
    <tbody>
      {% for r in s.rows %}
      <tr class="row">
        <td class="c-sn">{{ r.sn }}</td>
        <td class="txt">{{ r.district }}</td>
        {{ nums(r, reg) }}
        <td class="comp{% if r.level %} lvl-{{ r.level | lower }}{% endif %}">{{ r.competency }}</td>
        <td class="b c-rank">{{ r.rank }}</td>
      </tr>
      {% endfor %}
      {% if s.total %}
      <tr class="row total">
        <td class="txt b" colspan="2">TOTAL</td>
        {{ nums(s.total, reg) }}
        <td class="comp{% if s.total.level %} lvl-{{ s.total.level | lower }}{% endif %}">{{ s.total.competency }}</td>
        <td class="b c-rank">{{ s.total.rank }}</td>
      </tr>
      {% endif %}
    </tbody>
  </table>
</div>
{% endfor %}
</body>
</html>
