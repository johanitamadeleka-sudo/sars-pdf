{%- set LAYOUTS = {'overall': OVERALL, 'government': GOVERNMENT, 'private': PRIVATE,
                   'percentage': PERCENTAGE, 'kpi': PERCENTAGE} %}
{#- font metrics (ascent, descent per em) of the faces WeasyPrint embeds: A = Arial
    (Liberation Sans), N = Arial Narrow (Liberation Sans Narrow), C = Calibri (Carlito) -#}
{%- set MET = {'A': [0.905, 0.212], 'N': [0.9355, 0.2119], 'C': [0.952, 0.2686]} %}

{#- font-size / line-height / padding-bottom that put a bottom-aligned line's baseline
    `boi` pt above the cell's inner bottom edge, within `avail` pt of content height -#}
{%- macro v(fk, s, boi, avail) -%}
{%- set a = MET[fk][0] %}{% set d = MET[fk][1] -%}
{%- set L = (a + d) * s %}{% set pb = boi - d * s -%}
{%- if pb < 0 %}{% set L = 2 * (boi + (a - d) / 2 * s) %}{% set pb = 0 %}{% endif -%}
{%- if pb + L > avail %}{% set L = 2 * (avail - boi - (a - d) / 2 * s) %}{% set pb = avail - L %}{% endif -%}
font-size: {{ '%.2f' % s }}pt; line-height: {{ '%.3f' % L }}pt; padding-bottom: {{ '%.3f' % pb }}pt;
{%- endmacro %}
{#- bottom offset of an absolutely placed span (em-box line height) in a .anc anchor -#}
{%- macro anc(fk, s, boi) -%}
font-size: {{ '%.2f' % s }}pt; line-height: {{ '%.3f' % ((MET[fk][0] + MET[fk][1]) * s) }}pt; bottom: {{ '%.3f' % (boi - MET[fk][1] * s) }}pt;
{%- endmacro %}

{%- macro layout_css(k, L, nlines) -%}
{%- set tn = L.w[0] %}{% set tk = L.w[1] %}{% set f = L.f %}{% set bo = L.bo %}{% set ti = L.ti -%}
{%- set h0 = L.h[0] %}{% set h1 = L.h[1] %}{% set hb = L.h[2] %}{% set ht = L.h[3] -%}
{%- set em_t = 1.117 * ti.f %}{% set t0 = ti.base - ((ti.pitch - em_t) / 2 + 0.905 * ti.f) -%}
{%- set b = ti.band -%}
.k-{{ k }} { --thin: {{ tn }}pt; --thick: {{ tk }}pt; }
.k-{{ k }} .titles { width: {{ '%.2f' % (2 * ti.cx) }}pt; padding-top: {{ '%.3f' % t0 }}pt; font-size: {{ ti.f }}pt; line-height: {{ ti.pitch }}pt; }
.k-{{ k }} .band { margin: {{ '%.3f' % (b[1] - t0 - nlines * ti.pitch) }}pt 0 0 {{ b[0] }}pt; width: {{ '%.2f' % (b[2] - b[0]) }}pt; height: {{ '%.2f' % (b[3] - b[1]) }}pt; padding-top: {{ '%.3f' % (ti.sec - b[1] - 0.905 * ti.f) }}pt; font-size: {{ ti.f }}pt; line-height: {{ '%.3f' % em_t }}pt; text-indent: {{ '%.2f' % (2 * (ti.sec_cx - (b[0] + b[2]) / 2)) }}pt; }
.k-{{ k }} table.grid { width: {{ '%.2f' % (L.cols | sum) }}pt; margin: {{ '%.3f' % (L.y - tn / 2 - b[3]) }}pt 0 0 {{ '%.3f' % (L.x - tn / 2) }}pt; }
.k-{{ k }} tr.h0 { height: {{ h0 }}pt; }
.k-{{ k }} tr.h1 { height: {{ h1 }}pt; }
.k-{{ k }} tr.row { height: {{ hb }}pt; }
.k-{{ k }} tr.total { height: {{ ht }}pt; }
{#- header band 1 (thin rules above and below) #}
.k-{{ k }} th.g-grp { {{ v('A', f.g, bo.grp - tn / 2, h0 - tn) }} }
.k-{{ k }} th.g-sat { {{ v('N', f.h, bo.sat - tn / 2, h0 - tn) }} }
{%- if bo.reg %}
.k-{{ k }} th.g-reg { {{ v('N', f.hm, bo.reg - tn / 2, h0 - tn) }} }
{%- endif %}
{#- rowspan header labels, anchored on the band-2 bottom rule (thin under these) #}
.k-{{ k }} th.h-sn .anc span, .k-{{ k }} th.h-dist .anc span { {{ anc('N', f.h, bo.h - tn / 2) }} }
{%- set lp = bo.nos1 - bo.nos2 %}{% set em_n = 1.1474 * f.hs %}
.k-{{ k }} th.h-nos .anc span { font-size: {{ f.hs }}pt; line-height: {{ '%.3f' % lp }}pt; bottom: {{ '%.3f' % (bo.nos2 - tn / 2 - ((lp - em_n) / 2 + 0.2119 * f.hs)) }}pt; }
.k-{{ k }} th.h-gpa .anc span { {{ anc('A', f.g, bo.gpa_h - tn / 2) }} }
.k-{{ k }} th.h-comp .anc span { {{ anc('N', f.hm, bo.comp_h - tn / 2) }} }
.k-{{ k }} th.h-rank .anc span.rot { font-size: {{ f.rot }}pt; line-height: {{ '%.3f' % (1.1474 * f.rot) }}pt; left: {{ '%.3f' % (L.dx.rank - tn / 2 + 0.2119 * f.rot) }}pt; bottom: {{ '%.3f' % (bo.rank - tn / 2) }}pt; }
{#- header band 2: F / M / T / % (thick rule below the grouped columns) #}
.k-{{ k }} th.fmt { {{ v('N', f.h, bo.fmt - tn / 2, h1 - tn) }} }
.k-{{ k }} th.fmt.tb { {{ v('N', f.h, bo.fmt - tk / 2, h1 - tn / 2 - tk / 2) }} }
.k-{{ k }} th.spct { {{ v('N', f.h, bo.spct - tk / 2, h1 - tn / 2 - tk / 2) }} }
{#- district rows: bottom-aligned group (S/N .. IV, RANK) and centred group (0 .. COMPETENCY) #}
{%- set av = hb - tn / 2 - tk / 2 %}
.k-{{ k }} td.sn { {{ v('C', f.sn, bo.b - tn / 2, av) }} }
.k-{{ k }} td.dist { {{ v('A', f.b, bo.b - tn / 2, av) }} padding-left: {{ '%.3f' % (L.dx.dist - tn / 2) }}pt; }
.k-{{ k }} td.sch { {{ v('A', f.sch, bo.b - tn / 2, av) }} }
.k-{{ k }} td.nb { {{ v('A', f.b, bo.b - tn / 2, av) }} }
.k-{{ k }} td.nc { {{ v('A', f.b, bo.c - tn / 2, av) }} }
.k-{{ k }} td.comp { {{ v('A', f.b, bo.c - tn / 2, av) }} padding-left: {{ '%.3f' % (L.dx.comp - tn / 2) }}pt; }
.k-{{ k }} td.rk { {{ v('A', f.rk, bo.b - tn / 2, av) }} }
{#- the last district row: the original lifts its bottom-aligned text above the TOTAL row's thick rule #}
.k-{{ k }} tr.last td.sn { {{ v('C', f.sn, bo.b + bo.lift - tn / 2, av) }} }
.k-{{ k }} tr.last td.dist { {{ v('A', f.b, bo.b + bo.lift - tn / 2, av) }} }
.k-{{ k }} tr.last td.sch { {{ v('A', f.sch, bo.b + bo.lift - tk / 2, hb - tk) }} }
.k-{{ k }} tr.last td.nb { {{ v('A', f.b, bo.b + bo.lift - tk / 2, hb - tk) }} }
.k-{{ k }} tr.last td.nc { {{ v('A', f.b, bo.c - tk / 2, hb - tk) }} }
.k-{{ k }} tr.last td.rk { {{ v('A', f.rk, bo.b + bo.lift - tn / 2, av) }} }
{#- TOTAL row (thick box around NUMBER OF SCHOOLS .. GPA) #}
.k-{{ k }} td.t-label { {{ v('C', f.t, bo.t - tn / 2, ht - tn) }} }
.k-{{ k }} td.t-sch { {{ v('C', f.tsch, bo.tsch - tk / 2, ht - tk) }} }
.k-{{ k }} td.t-num { {{ v('C', f.tn, bo.tn - tk / 2, ht - tk) }} }
.k-{{ k }} td.t-comp { {{ v('C', f.tc, bo.tc - tn / 2, ht - tn) }} padding-left: {{ '%.3f' % (L.dx.tcomp - tk / 2) }}pt; }
{%- endmacro %}

{#- numeric columns NUMBER OF SCHOOLS .. GPA:
    (key, bold in the rows, row fill, TOTAL fill, group: b = bottom-aligned / c = centred,
     thick left rule in the rows, thick left rule in the TOTAL row, band-2 label, band-2 fill,
     thick rule under the band-2 label) -#}
{%- set NUMS = [
    ('schools', 0, 'f-sch', 'f-tsch', 'b', 0, 1, '', '', 0),
    ('reg_f', 0, '', '', 'b', 1, 1, 'F', '', 1),
    ('reg_m', 0, '', '', 'b', 0, 0, 'M', '', 1),
    ('reg_t', 1, '', '', 'b', 0, 0, 'T', '', 1),
    ('sat_f', 0, '', '', 'b', 1, 0, 'F', 'f-hsat', 1),
    ('sat_m', 0, '', '', 'b', 0, 0, 'M', 'f-hsat', 1),
    ('sat_t', 1, '', '', 'b', 0, 0, 'T', 'f-hsat', 1),
    ('sat_pct', 1, 'f-sp', 'f-tsp', 'b', 0, 0, '%', 'f-hsat', 1),
    ('i_f', 0, '', '', 'b', 1, 1, 'F', '', 0),
    ('i_m', 0, '', '', 'b', 0, 0, 'M', '', 0),
    ('i_t', 1, '', '', 'b', 0, 0, 'T', '', 0),
    ('ii_f', 0, '', '', 'b', 0, 0, 'F', '', 0),
    ('ii_m', 0, '', '', 'b', 0, 0, 'M', '', 0),
    ('ii_t', 1, '', '', 'b', 0, 0, 'T', '', 0),
    ('iii_f', 0, '', '', 'b', 0, 0, 'F', '', 0),
    ('iii_m', 0, '', '', 'b', 0, 0, 'M', '', 0),
    ('iii_t', 1, '', '', 'b', 0, 0, 'T', '', 0),
    ('iv_f', 0, '', '', 'b', 0, 0, 'F', '', 0),
    ('iv_m', 0, '', '', 'b', 0, 0, 'M', '', 0),
    ('iv_t', 1, '', '', 'b', 0, 0, 'T', '', 0),
    ('z_f', 0, 'f-z', 'f-z', 'c', 1, 0, 'F', 'f-hz', 1),
    ('z_m', 0, 'f-z', 'f-z', 'c', 0, 0, 'M', 'f-hz', 1),
    ('z_t', 0, 'f-z', 'f-z', 'c', 0, 0, 'T', 'f-hz', 1),
    ('z_pct', 1, 'f-zp', 'f-tzp', 'c', 0, 0, '%', 'f-hzp', 1),
    ('d3_f', 1, 'f-d3', 'f-td3', 'c', 1, 1, 'F', 'f-hd3', 1),
    ('d3_m', 1, 'f-d3', 'f-td3', 'c', 0, 0, 'M', 'f-hd3', 1),
    ('d3_t', 1, 'f-d3', 'f-td3', 'c', 0, 0, 'T', 'f-hd3', 1),
    ('d3_pct', 1, 'f-d3p', 'f-td3', 'c', 0, 0, '%', 'f-hd3', 1),
    ('d4_f', 0, '', '', 'c', 1, 0, 'F', '', 1),
    ('d4_m', 0, '', '', 'c', 0, 0, 'M', '', 1),
    ('d4_t', 0, '', '', 'c', 0, 0, 'T', '', 1),
    ('d4_pct', 1, 'f-d4p', 'f-td4p', 'c', 0, 0, '%', 'f-hd4p', 1),
    ('gpa', 0, 'f-gpa', 'f-tgpa', 'c', 1, 1, '', '', 0),
] %}
{%- set NLINES = (doc.document.ministry | length) + 1 %}
<style>
{% for k, L in LAYOUTS.items() %}
