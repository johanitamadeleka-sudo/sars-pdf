<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
{# grid rules painted as one anti-aliased fill like this "Microsoft: Print To PDF" original (sars_pdf/rules.py) #}
<meta name="sars-pdf:rules" content="filled-aa">
<title>{{ doc.tables[0].title if doc.tables else 'School rank subjectwise' }}</title>
<link rel="stylesheet" href="style.css">
{#
  Region schools rank, subjectwise (LEVEL + FUNCTION name). One table per subject:
  S/N | COUNCIL | SCHOOL NAME | A B C D F | TOTAL | A-C %A-C A-D %A-D | GPA
      | COMPETENCY LEVEL | C/RANK | R/RANK, then a COUNCIL OVERALL PERFORMANCE row.
  Fully self-contained (own template + own style.css, inline @font-face, no shared
  stylesheet). Data-driven and location-agnostic; this original does NOT tint the school-row
  competency cells (they are plain white); there is no data-driven colour in this report.

  The two header bands repeat at the top of every continuation page (running header in the
  page's top margin), exactly as this "Microsoft: Print To PDF" original prints them; the
  rows flow wherever the page fills. One template + CSS drives both source subjects (EDK 1pp
  and English 6pp); each keeps its own data file and output.

  Geometry measured from the original (rule centres, baselines above the rule centre below
  each cell, fonts) lives HERE in one place and is emitted as CSS below.
#}
{%- set COLS = [24.12, 55.44, 77.28, 23.4, 23.4, 23.4, 23.4, 23.4, 28.68, 23.4, 28.68, 23.4, 28.68, 43.2, 77.04, 13.08, 18.24] %}
{%- set X0 = 31.68 %}{% set CX = 302.05 %}{% set TOP = 60.0 %}
{%- set P2_Y0 = 60.0 %}{% set P2_ROW = 88.32 %}
{%- set TN = 0.48 %}{% set TK = 0.96 %}
{%- set H = {'h0': 13.92, 'h1': 10.08, 'row': 10.08, 'ov': 12.48} %}
{%- set TI = {'f': 7.19, 'sub': 8.14, 'base': [68.04, 78.12, 88.2, 98.28], 'cx': 302.05,
              'band': [32.2, 100.32, 571.8, 115.32], 'sub_base': 110.16, 'sub_cx': 302.03} %}
{%- set BO = {'row': 1.8, 'lift': 0.24, 'h0': 2.04, 'ov': 2.04,
              'crank_x': 8.56, 'rrank_x': 10.84, 'rank_b': 0.84} %}
{%- set MET = {'A': [0.905, 0.212], 'N': [0.9355, 0.2119]} %}

{%- macro v(fk, s, boi, avail) -%}
{%- set a = MET[fk][0] %}{% set d = MET[fk][1] -%}
{%- set L = (a + d) * s %}{% set pb = boi - d * s -%}
{%- if pb < 0 %}{% set L = 2 * (boi + (a - d) / 2 * s) %}{% set pb = 0 %}{% endif -%}
{%- if pb + L > avail %}{% set L = 2 * (avail - boi - (a - d) / 2 * s) %}{% set pb = avail - L %}{% endif -%}
font-size: {{ '%.2f' % s }}pt; line-height: {{ '%.3f' % L }}pt; padding-bottom: {{ '%.3f' % pb }}pt;
{%- endmacro %}
{%- set nl = (doc.document.ministry | length) + 1 %}
{%- set em_t = 1.117 * TI.f %}{% set b = TI.band %}
<style>
@page { margin-top: {{ '%.3f' % (P2_ROW - TN / 2) }}pt;
  @top-left { content: element(runhdr); vertical-align: top; padding: {{ '%.3f' % (P2_Y0 - TK / 2) }}pt 0 0 {{ '%.3f' % (X0 - TN / 2) }}pt; } }
@page :first { margin-top: {{ TOP }}pt; margin-bottom: {{ '%.2f' % (792 - 771.0) }}pt; @top-left { content: none; } }
table.grid.runhdr { position: running(runhdr); margin: 0; width: {{ '%.2f' % (COLS | sum) }}pt; }
.titles { margin-left: {{ '%.2f' % (2 * TI.cx - 612) }}pt; font-size: {{ TI.f }}pt; line-height: {{ '%.3f' % em_t }}pt; }
{%- for i in range(nl) %}
{%- set bi = TI.base[i] if i < TI.base | length else TI.base[-1] + (i + 1 - TI.base | length) * (TI.base[-1] - TI.base[-2]) %}
{%- set bp = TI.base[i - 1] if i - 1 < TI.base | length else TI.base[-1] + (i - TI.base | length) * (TI.base[-1] - TI.base[-2]) %}
.titles .hl:nth-child({{ i + 1 }}) { margin-top: {{ '%.3f' % ((bi - 0.905 * TI.f - TOP) if i == 0 else (bi - bp - em_t)) }}pt; }
{%- endfor %}
{%- set last = TI.base[nl - 1] if nl <= TI.base | length else TI.base[-1] + (nl - TI.base | length) * (TI.base[-1] - TI.base[-2]) %}
.band { margin: {{ '%.3f' % (b[1] - (last - 0.905 * TI.f + em_t)) }}pt 0 0 {{ b[0] }}pt; width: {{ '%.2f' % (b[2] - b[0]) }}pt; height: {{ '%.2f' % (b[3] - b[1]) }}pt; padding-top: {{ '%.3f' % (TI.sub_base - b[1] - 0.905 * TI.sub) }}pt; font-size: {{ TI.sub }}pt; line-height: {{ '%.3f' % (1.117 * TI.sub) }}pt; text-indent: {{ '%.2f' % (2 * (TI.sub_cx - (b[0] + b[2]) / 2)) }}pt; }
table.grid { width: {{ '%.2f' % (COLS | sum) }}pt; margin: {{ '%.3f' % (115.2 - TK / 2 - b[3]) }}pt 0 0 {{ '%.2f' % (X0 - TN / 2) }}pt; }
tr.h0 { height: {{ H.h0 }}pt; }
tr.h1 { height: {{ H.h0 }}pt; }
tr.row { height: {{ H.row }}pt; }
tr.ov { height: {{ H.ov }}pt; }
th.h { {{ v('N', TI.f, BO.h0 - TN / 2, 2 * H.h0 - TN) }} }
th.h.ab { {{ v('A', TI.f, BO.h0 - TN / 2, 2 * H.h0 - TN) }} }
th.h.tot { {{ v('N', 6.11, BO.h0 - TN / 2, H.h0 - TN) }} }
th.h.comp { {{ v('N', 6.59, BO.h0 - TN / 2, 2 * H.h0 - TN) }} }
th.h-rank .anc span.rot { font-size: 6.12pt; line-height: {{ '%.3f' % (1.1474 * 6.12) }}pt; bottom: {{ '%.3f' % (BO.rank_b - TN / 2) }}pt; }
th.h-crank .anc span.rot { left: {{ '%.3f' % (BO.crank_x - TN / 2 + 0.2119 * 6.12) }}pt; }
th.h-rrank .anc span.rot { left: {{ '%.3f' % (BO.rrank_x - TN / 2 + 0.2119 * 6.12) }}pt; }
{%- set av = H.row - TN %}
td.sn, td.council, td.school, td.n { {{ v('A', 6.11, BO.row - TN / 2, av) }} }
td.nb, td.pct { {{ v('A', 7.19, BO.row - TN / 2, av) }} }
td.gpa { {{ v('A', 7.19, BO.row - TN / 2, av) }} }
td.comp { {{ v('A', 7.19, BO.row - TN / 2, av) }} }
td.rk { {{ v('A', 6.11, BO.row - TN / 2, av) }} }
tr.last td { padding-bottom: {{ '%.3f' % (BO.row + BO.lift - TN / 2 - MET['A'][1] * 6.11) }}pt; }
td.ov-l { {{ v('A', TI.f, BO.ov - TN / 2, H.ov - TN) }} }
td.ov-n { {{ v('A', TI.f, BO.ov - TN / 2, H.ov - TN) }} }
td.ov-c { {{ v('A', 6.59, BO.ov - TN / 2, H.ov - TN) }} }
</style>
</head>
<body>
{%- set t = doc.tables[0] %}
{%- macro header_rows() %}
      <tr class="h0 band0">
        <th rowspan="2" class="h f-hsn">S/N</th>
        <th rowspan="2" class="h">COUNCIL</th>
        <th rowspan="2" class="h tr">SCHOOL NAME</th>
        <th colspan="10" class="h ab tl tr">GRADING PERFORMANCE</th>
        <th rowspan="2" class="h ab f-hgpa tl">GPA</th>
        <th rowspan="2" class="h comp">COMPENTENCY LEVEL</th>
        <th rowspan="2" class="h-crank f-hrank tl"><div class="anc"><span class="rot">C/RANK</span></div></th>
        <th rowspan="2" class="h-rrank f-hrank"><div class="anc"><span class="rot">R/RANK</span></div></th>
      </tr>
      <tr class="h1 band1">
        <th class="h ab tl tt tb f-hg">A</th>
        <th class="h ab tt tb f-hg">B</th>
        <th class="h ab tt tb f-hg">C</th>
        <th class="h ab tt tb f-hg">D</th>
        <th class="h ab tt tb f-hf">F</th>
        <th class="h tot tr tt tb f-htot">TOTAL</th>
        <th class="h ab tl tt tb f-hac">A-C</th>
        <th class="h ab tr tt tb f-hac">%A-C</th>
        <th class="h ab tl tt tb f-had">A-D</th>
        <th class="h ab tr tt tb f-had">%A-D</th>
      </tr>
{%- endmacro %}
<table class="grid runhdr">
  <colgroup>{% for w in COLS %}<col style="width:{{ w }}pt">{% endfor %}</colgroup>
  <tbody>
{{ header_rows() }}  </tbody>
</table>
<div class="titles">
  {% for line in doc.document.ministry %}
  <div class="hl">{{ line }}</div>
  {% endfor %}
  <div class="hl">{{ doc.document.exam_name }}</div>
</div>
<div class="band">{{ t.title }}</div>

<table class="grid">
  <colgroup>{% for w in COLS %}<col style="width:{{ w }}pt">{% endfor %}</colgroup>
  <tbody>
{{ header_rows() }}    {% for r in t.rows %}
    <tr class="row{% if loop.last %} last{% endif %}">
      <td class="sn"{{ fit(r.sn, COLS[0] - 1.0, 6.11) }}>{{ r.sn }}</td>
      <td class="council"{{ fit(r.council, COLS[1] - 1.4, 6.11) }}>{{ r.council }}</td>
      <td class="school"{{ fit(r.school, COLS[2] - 1.4, 6.11) }}>{{ r.school }}</td>
      <td class="n"{{ fit(r.a, COLS[3] - 1.0, 6.11) }}>{{ r.a }}</td>
      <td class="n"{{ fit(r.b, COLS[4] - 1.0, 6.11) }}>{{ r.b }}</td>
      <td class="n"{{ fit(r.c, COLS[5] - 1.0, 6.11) }}>{{ r.c }}</td>
      <td class="n"{{ fit(r.d, COLS[6] - 1.0, 6.11) }}>{{ r.d }}</td>
      <td class="nb f-f"{{ fit(r.f, COLS[7] - 1.0, 6.11, bold=True) }}>{{ r.f }}</td>
      <td class="nb tr"{{ fit(r.total, COLS[8] - 1.4, 6.11, bold=True) }}>{{ r.total }}</td>
      <td class="pct tl f-ac"{{ fit(r.a_c, COLS[9] - 1.4, 7.19, bold=True) }}>{{ r.a_c }}</td>
      <td class="pct f-ac"{{ fit(r.pct_a_c, COLS[10] - 1.0, 7.19, bold=True) }}>{{ r.pct_a_c }}</td>
      <td class="pct f-ad"{{ fit(r.a_d, COLS[11] - 1.0, 7.19, bold=True) }}>{{ r.a_d }}</td>
      <td class="pct f-ad"{{ fit(r.pct_a_d, COLS[12] - 1.4, 7.19, bold=True) }}>{{ r.pct_a_d }}</td>
      <td class="gpa tl"{{ fit(r.gpa, COLS[13] - 1.4, 7.19, bold=True) }}>{{ r.gpa }}</td>
      <td class="comp"{{ fit(r.competency, COLS[14] - 1.4, 7.19) }}>{{ r.competency }}</td>
      <td class="rk"{{ fit(r.c_rank, COLS[15] - 1.0, 6.11) }}>{{ r.c_rank }}</td>
      <td class="rk"{{ fit(r.rank, COLS[16] - 1.0, 6.11) }}>{{ r.rank }}</td>
    </tr>
    {% endfor %}
    {% if t.overall %}
    {% set o = t.overall %}
    <tr class="ov">
      <td colspan="3" class="ov-l nr tt">{{ o.label }}</td>
      {% for key, fa, tla in [('a', 'f-oc', 1), ('b', 'f-oc', 0), ('c', 'f-oc', 0), ('d', 'f-oc', 0),
                              ('f', 'f-of', 0), ('total', 'f-of', 0), ('a_c', 'f-oac', 1), ('pct_a_c', 'f-oac', 0),
                              ('a_d', 'f-oad', 1), ('pct_a_d', 'f-oad', 0), ('gpa', 'f-ogpa', 1)] %}
      <td class="ov-n tt {{ fa }}{% if tla %} tl{% endif %}"{{ fit(o[key], COLS[3 + loop.index0] - 1.4, 7.19, bold=True) }}>{{ o[key] }}</td>
      {% endfor %}
      <td colspan="2" class="ov-c tl tt f-ocomp"{{ fit(o.competency, COLS[14] - 1.4, 6.59, bold=True) }}>{{ o.competency }}</td>
      <td class="ov-blank tt f-oblank"></td>
    </tr>
    {% endif %}
  </tbody>
</table>
</body>
</html>
