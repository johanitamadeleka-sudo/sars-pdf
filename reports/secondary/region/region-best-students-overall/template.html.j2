<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ doc.document.report_title }}</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
{#
  Region best students overall (LEVEL + FUNCTION name). Section-centric: 9 stacked top-10
  tables (one per page). Fully self-contained (own template + own style.css, inline
  @font-face, no shared stylesheet). Data-driven and location-agnostic. No competency
  column here; every colour/fill is a fixed identical palette.

  Region variant of the council best-students-overall: adds S/NO. and COUNCIL columns.
  Columns: S/NO. | COUNCIL | C/NO | SCHOOL NAME | CANDIDATE FULL NAME | SEX | AGGT
           | DIVISION | POS | DETAILED SUBJECTS
#}
{% for s in doc.sections %}
<div class="section{% if not loop.first %} page-top{% endif %}">
  <div class="titles">
    {% for line in doc.document.ministry %}
    <div class="hl ministry">{{ line }}</div>
    {% endfor %}
    <div class="hl exam-name">{{ doc.document.exam_name }}</div>
  </div>
  <div class="sec-title">{{ s.title }}</div>
  <table class="students">
    <colgroup>
      <col class="w-sno"><col class="w-council"><col class="w-cno"><col class="w-school"><col class="w-cand">
      <col class="w-sex"><col class="w-aggt"><col class="w-div"><col class="w-pos">
      <col class="w-det">
    </colgroup>
    <thead>
      <tr>
        <th rowspan="2" class="v-mid">S/NO.</th>
        <th rowspan="2" class="v-mid">COUNCIL</th>
        <th rowspan="2" class="v-mid cno-h">C/NO</th>
        <th rowspan="2" class="v-mid">SCHOOL NAME</th>
        <th rowspan="2" class="v-mid">CANDIDATE FULL  NAME</th>
        <th class="vcol fill-sex-h"><div class="vert"><span>SEX</span></div></th>
        <th class="vcol fill-aggt-h"><div class="vert"><span>AGGT</span></div></th>
        <th class="vcol fill-sex-h"><div class="vert"><span>DIVISION</span></div></th>
        <th class="vcol"><div class="vert"><span>POS</span></div></th>
        <th rowspan="2" class="v-mid">DETAILED SUBJECTS</th>
      </tr>
      <tr class="h-spacer"><th></th><th></th><th></th><th></th></tr>
    </thead>
    <tbody>
      {% for r in s.rows %}
      <tr class="row">
        <td class="c-sno">{{ r.sno }}</td>
        <td class="txt">{{ r.council }}</td>
        <td class="c-cno">{{ r.cno }}</td>
        <td class="txt">{{ r.school }}</td>
        <td class="txt cand">{{ r.candidate }}</td>
        <td>{{ r.sex }}</td>
        <td>{{ r.aggt }}</td>
        <td>{{ r.division }}</td>
        <td class="c-pos">{{ r.position }}</td>
        <td class="txt det">{{ r.detailed }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}
</body>
</html>
