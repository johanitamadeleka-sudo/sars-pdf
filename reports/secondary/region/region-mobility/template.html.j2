<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ doc.document.report_title }}</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
{#
  Region mobility (LEVEL + FUNCTION name). Region-only report: FTNA 2025 vs MOCK 2026 GPA
  movement, flowing across 6 portrait pages. Fully self-contained (own template + own
  style.css, inline @font-face, no shared stylesheet). Data-driven and location-agnostic.
  No competency column here; every colour/fill is a fixed identical palette. Swahili labels
  (MJONGEO / CHANYA / IMEPANDA / UMESHUKA) come straight from data.json, preserved exactly.

  Columns: S/NO. | COUNCIL | SCHOOL NAME | OWNERSHIP
    | FTNA 2025(TOTAL %(I-III) GPA) | MOCK 2026(TOTAL %(I-III) GPA)
    | CHANYA | MJONGEO WA GPA | HALI YA MJONGEO
#}
<div class="titles">
  {% for line in doc.document.ministry %}
  <div class="hl ministry">{{ line }}</div>
  {% endfor %}
  <div class="hl exam-name">{{ doc.document.exam_name }}</div>
  <div class="hl report-title">{{ doc.document.report_title }}</div>
</div>

<table class="mob">
  <colgroup>
    <col class="w-sno"><col class="w-council"><col class="w-school"><col class="w-own">
    <col class="w-ft"><col class="w-fp"><col class="w-fg">
    <col class="w-mt"><col class="w-mp"><col class="w-mg">
    <col class="w-ch"><col class="w-mj"><col class="w-hali">
  </colgroup>
  <thead>
    <tr class="h1">
      <th rowspan="3" class="v-mid">S/NO.</th>
      <th rowspan="3" class="v-mid">COUNCIL</th>
      <th rowspan="3" class="v-mid">SCHOOL NAME</th>
      <th rowspan="3" class="v-mid">OWNERSHIP</th>
      <th colspan="3" class="grp fill-ftna">FTNA 2025</th>
      <th colspan="3" class="grp fill-mock">MOCK 2026</th>
      <th rowspan="3" class="v-mid">CHANYA</th>
      <th rowspan="3" class="v-mid nowrap">MJONGEO<br>WA GPA</th>
      <th rowspan="3" class="v-mid nowrap">HALI YA<br>MJONGEO</th>
    </tr>
    <tr class="h2">
      <th class="fill-ftna">TOTAL</th><th class="fill-ftna">%(I-III)</th><th class="fill-ftna">GPA</th>
      <th class="fill-mock">TOTAL</th><th class="fill-mock">%(I-III)</th><th class="fill-mock">GPA</th>
    </tr>
    <tr class="h3"><th></th><th></th><th></th><th></th><th></th><th></th></tr>
  </thead>
  <tbody>
    {% for r in doc.rows %}
    <tr class="row">
      <td class="c-sno">{{ r.sno }}</td>
      <td class="txt">{{ r.council }}</td>
      <td class="txt">{{ r.school }}</td>
      <td class="txt">{{ r.ownership }}</td>
      <td>{{ r.ftna_total }}</td><td>{{ r.ftna_pct }}</td><td class="b">{{ r.ftna_gpa }}</td>
      <td>{{ r.mock_total }}</td><td>{{ r.mock_pct }}</td><td class="b">{{ r.mock_gpa }}</td>
      <td>{{ r.chanya }}</td>
      <td class="b">{{ r.mjongeo }}</td>
      <td class="txt hali">{{ r.hali }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</body>
</html>
